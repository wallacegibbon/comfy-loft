COMFY_URL=http://127.0.0.1:8188

# 1 = this machine can write into ComfyUI's folders (same machine, or a mount).
INSTALL_INTO_COMFY=1

# Put this machine's LAN address here for a browser on another device. The canvas is served from this
# same address and port, so there is no second port to open and no CORS origin to list. See docs/gateway.md.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8190

# Where the canvases live, one directory each. Defaults to ./canvases; see docs/gateway.md.
# CANVAS_ROOT=/path/to/canvases

# Set only when the canvas is served from somewhere other than this gateway (another host, another port,
# a static host of your own): the address a browser should use to reach the gateway.
# PUBLIC_BASE_URL=http://192.168.3.232:8190
